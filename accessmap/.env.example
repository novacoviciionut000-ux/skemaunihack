# ==============================================================================
# AccessMap - Configurare Autentificare Reala Google & Email de Confirmare
# ==============================================================================
# Copiază acest fișier ca `.env` în rădăcina proiectului sau în folderul accessmap/.

# ------------------------------------------------------------------------------
# 1. GOOGLE IDENTITY SERVICES (OAuth 2.0 Web Client)
# ------------------------------------------------------------------------------
# Obține Client ID din Google Cloud Console (APIs & Services -> Credentials -> Create Credentials -> OAuth client ID -> Web application)
# Asigură-te că în "Authorized JavaScript origins" ai adăugat:
#   http://localhost:3000
#   http://localhost:8080
#   (și URL-ul de tunel Cloudflare dacă testezi pe telefon mobil: ex. https://xxx.trycloudflare.com)
GOOGLE_CLIENT_ID=***REMOVED***
VITE_GOOGLE_CLIENT_ID=***REMOVED***

# ------------------------------------------------------------------------------
# 2. EXPEDIERE LIVE EMAIL DE CONFIRMARE (Gmail SMTP / Orice server SMTP)
# ------------------------------------------------------------------------------
# Pentru Gmail:
#   1. Mergi în contul tău Google -> Securitate (Security)
#   2. Asigură-te că "Verificare în doi pași" (2-Step Verification) este activată
#   3. Caută "Parole pentru aplicații" (App Passwords)
#   4. Generează o parolă de 16 caractere pentru "AccessMap"
#   5. Completează valorile de mai jos:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply.accessmap@gmail.com
MAIL_ENABLED=true
